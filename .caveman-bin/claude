#!/usr/bin/env python3

import os
import subprocess
import sys


if sys.argv[1:] == ["--print"]:
    env = os.environ.copy()
    env.pop("XDG_DATA_HOME", None)
    result = subprocess.run(
        ["opencode", "run", "--pure", "-m", "openai/gpt-5.6-sol", sys.stdin.read()],
        check=False,
        env=env,
    )
    raise SystemExit(result.returncode)

raise SystemExit(subprocess.run(["opencode", *sys.argv[1:]], check=False).returncode)
