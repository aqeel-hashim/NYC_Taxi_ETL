# Environment variables for local development
# Copy to .env and fill in values. Never commit secrets.

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=taxi_warehouse
POSTGRES_USER=taxi_app
POSTGRES_PASSWORD=change-me-outside-git
DATABASE_URL=postgresql+psycopg://taxi_app:change-me-outside-git@127.0.0.1:5432/taxi_warehouse

# Airflow metadata database
AIRFLOW_DB_HOST=localhost
AIRFLOW_DB_PORT=5432
AIRFLOW_DB_NAME=airflow
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=change-me-outside-git

# MinIO
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change-me-outside-git
MINIO_SECURE=false

# Airflow
AIRFLOW__CORE__LOAD_EXAMPLES=false
AIRFLOW__LOGGING__LOGGING_LEVEL=INFO
AIRFLOW__WEBSERVER__EXPOSE_CONFIG=true

# TLC source
TLC_SOURCE_BUCKET=https://d37ci6vzurychx.cloudfront.net/trip-data
TLC_SOURCE_PREFIX=yellow_tripdata

# App
NYC_TAXI_ENV=development
NYC_TAXI_LOG_LEVEL=INFO
